# --- Параметры подключения к PostgreSQL ---
# Используется приложением и Alembic.
# В docker-compose хост БД = имя сервиса (db), локально — localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=wallets
POSTGRES_USER=wallet_user
POSTGRES_PASSWORD=wallet_password

# --- Настройки приложения ---
APP_HOST=0.0.0.0
APP_PORT=8000
